{
  "name": "civitas-access",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Servidor de notificaciones push (Expo) de Civitas Access con panel web",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "api-key:create": "tsx src/cli/api-key.ts create",
    "api-key:list": "tsx src/cli/api-key.ts list",
    "api-key:revoke": "tsx src/cli/api-key.ts revoke",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^0.19.10",
    "expo-server-sdk": "^3.14.0",
    "hono": "^4.6.16",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=24"
  }
}
